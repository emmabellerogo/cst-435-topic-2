# Copy to ui/.streamlit/secrets.toml for local runs (it is gitignored), and paste
# the same keys into the app's Secrets box on Streamlit Community Cloud.
#
# Streamlit looks for .streamlit/secrets.toml in the folder you start it FROM, so
# with this file in ui/.streamlit/ start the app from inside ui/:
#     cd ui && ../.venv/bin/streamlit run app.py
# Or skip the file and pass environment variables from the repo root:
#     API_URL=http://localhost:8000 .venv/bin/streamlit run ui/app.py

# Required: the FastAPI base URL, no trailing slash.
#   local:  http://localhost:8000
#   Render: https://<your-api>.onrender.com
API_URL = "http://localhost:8000"

# Optional: lets the Model Performance and Model Card tabs read the runs table.
# Use the public ANON key only. NEVER put the service-role key in the UI.
# Without these, the tabs read the committed files in models/ instead.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
